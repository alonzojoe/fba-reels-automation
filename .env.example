# Copy this file to .env and fill in your keys.

# Pexels API key — used to download stock footage. Free tier sufficient.
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-key-here

# ElevenLabs API key — used for text-to-speech voiceover.
# Get a free key at https://elevenlabs.io/app/settings/api-keys
# Free tier = 10,000 characters/month (~25-30 reels at ~350 chars each).
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional: explicit paths to ffmpeg/ffprobe binaries. Only needed if you can't
# add a libass-enabled ffmpeg to PATH (e.g. Homebrew's ffmpeg-full is keg-only).
# Defaults to looking up "ffmpeg" and "ffprobe" on PATH.
# FFMPEG_BIN=/usr/local/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/usr/local/opt/ffmpeg-full/bin/ffprobe
